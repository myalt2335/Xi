// Xi standard library: map - typed-key maps.
//
// Like arrays, maps are polymorphic in their key/value types, so the operations
// are compiler intrinsics declared here to make the include mandatory and the
// API explicit.

intrinsic new;
intrinsic set;
intrinsic get;
intrinsic get_or;
intrinsic has;
intrinsic del;
intrinsic clear;
intrinsic len;
intrinsic keys;
intrinsic values;
